# Database Configuration (MongoDB Atlas or Local)
MONGODB_USERNAME=your-db-username
MONGODB_PASSWORD=your-db-password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/travel-tech?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-secure-random-secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Domain Configuration (Multi-tenancy)
NEXT_PUBLIC_MAIN_DOMAIN=travelcompany.com

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_FROM="Travel Company Invoice" <invoice@travelcompany.com>

# Agentic AI Backend (FastAPI)
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
