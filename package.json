{
  "name": "travel-company",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:all": "concurrently -n \"NEXT,FASTAPI\" -c \"blue,green\" \"next dev -p 3000\" \"python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "pytest",
    "test:unit": "pytest -m unit",
    "test:integration": "pytest -m integration",
    "test:e2e": "pytest -m e2e",
    "test:cov": "pytest --cov=backend/agents --cov=backend/pipeline --cov=backend/api --cov-report=term-missing"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "antd": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "mongodb": "^7.4.0",
    "mongoose": "^9.7.3",
    "next": "14.2.35",
    "next-auth": "^4.24.14",
    "next-intl": "^4.13.1",
    "nodemailer": "^7.0.13",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^10.0.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
