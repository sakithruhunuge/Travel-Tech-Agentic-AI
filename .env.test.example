# Test Environment Configuration Example
# Copy to .env.test or use with conftest.py defaults

# Environment mode
ENVIRONMENT=test
LOG_LEVEL=INFO

# MongoDB Connection Strings (Dummy or Local test instances)
MONGODB_URI=mongodb://localhost:27017/travel-tech-test
webscrape_URI=mongodb://localhost:27017/webscrape-test
WEBSCRAPE_URI=mongodb://localhost:27017/webscrape-test

# LLM Providers (Mocked during automated unit tests)
GEMINI_API_KEY=mock-gemini-test-key
GOOGLE_API_KEY=mock-google-test-key
OPENAI_API_KEY=mock-openai-test-key
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen3:8b

# Test Runner Configuration
RUN_LIVE_LLM_TESTS=false
